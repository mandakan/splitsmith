# The worker LISTENs, so its database URL is the direct (non-pooler) host.
SPLITSMITH_DATABASE_URL=production-worker-database-url
SPLITSMITH_S3_ENDPOINT_URL=production-s3-endpoint-url
SPLITSMITH_S3_ACCESS_KEY_ID=production-s3-access-key-id
SPLITSMITH_S3_SECRET_ACCESS_KEY=production-s3-secret-access-key
SPLITSMITH_YOUTUBE_CLIENT_SECRET=production-youtube-client-secret
SPLITSMITH_YOUTUBE_TOKEN_KEY=production-youtube-token-key
