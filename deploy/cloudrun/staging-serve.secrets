# ENV_VAR=secret-name, mounted at :latest from project splitsmith-hosting.
SPLITSMITH_DATABASE_URL=staging-database-url
SPLITSMITH_AGENT_DATABASE_URL=staging-agent-database-url
SPLITSMITH_S3_ENDPOINT_URL=staging-s3-endpoint-url
SPLITSMITH_S3_ACCESS_KEY_ID=staging-s3-access-key-id
SPLITSMITH_S3_SECRET_ACCESS_KEY=staging-s3-secret-access-key
SPLITSMITH_YOUTUBE_CLIENT_SECRET=staging-youtube-client-secret
SPLITSMITH_YOUTUBE_TOKEN_KEY=staging-youtube-token-key
SPLITSMITH_SSI_TOKEN=staging-ssi-token
SPLITSMITH_ADMIN_EMAILS=staging-admin-emails
SPLITSMITH_SIGNUP_ALLOWLIST=staging-signup-allowlist
