# ENV_VAR=secret-name, mounted at :latest from project splitsmith-hosting.
SPLITSMITH_DATABASE_URL=production-database-url
SPLITSMITH_AGENT_DATABASE_URL=production-agent-database-url
SPLITSMITH_S3_ENDPOINT_URL=production-s3-endpoint-url
SPLITSMITH_S3_ACCESS_KEY_ID=production-s3-access-key-id
SPLITSMITH_S3_SECRET_ACCESS_KEY=production-s3-secret-access-key
SPLITSMITH_YOUTUBE_CLIENT_SECRET=production-youtube-client-secret
SPLITSMITH_YOUTUBE_TOKEN_KEY=production-youtube-token-key
SPLITSMITH_SSI_TOKEN=production-ssi-token
SPLITSMITH_ADMIN_EMAILS=production-admin-emails
SPLITSMITH_SIGNUP_ALLOWLIST=production-signup-allowlist
LETTERMINT_API_TOKEN=production-lettermint-api-token
